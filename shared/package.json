{
  "name": "@tincan/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Wire protocol types and constants shared by the tincan client and server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
